{
  "name": "class-capacity-truth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:web": "tsc -b && vite build",
    "build": "npm run build:web && cargo build --release --manifest-path services/api/Cargo.toml",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && cargo test --manifest-path services/api/Cargo.toml",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:cold-claim": "bash scripts/test-cold-claim.sh",
    "test:api": "cargo test --manifest-path services/api/Cargo.toml --test api",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false && cargo fmt --manifest-path services/api/Cargo.toml --check && cargo clippy --manifest-path services/api/Cargo.toml --all-targets --all-features -- -D warnings",
    "start": "cargo run --release --manifest-path services/api/Cargo.toml"
  },
  "dependencies": {
    "@azure/msal-browser": "4.25.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
